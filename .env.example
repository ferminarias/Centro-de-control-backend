# Database
DATABASE_URL=postgresql://centro:centro_pass@localhost:5432/centro_control

# Security - CHANGE THESE IN PRODUCTION!
ADMIN_API_KEY=your-secure-admin-api-key-change-in-production
SECRET_KEY=your-secure-secret-key-change-in-production-min-32-chars

# Environment: development | staging | production
ENVIRONMENT=development

# CORS - Comma-separated list of allowed origins
# In production, set this to your frontend domains:
# ALLOWED_ORIGINS=https://app.tudominio.com,https://admin.tudominio.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Application
PORT=8000

# Field exclusions from auto-creation
EXCLUDED_FIELDS=["IDLOTE", "USUARIO_PREASIGNADO"]
