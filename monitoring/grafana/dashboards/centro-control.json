{
  "title": "Centro de Control - CRM Overview",
  "uid": "centro-control-crm",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "uid": "prometheus" },
          "expr": "rate(http_requests_total[1m])",
          "legendFormat": "{{method}} {{endpoint}} {{status_code}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "API Latency p50 / p95 / p99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": { "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p50"
        },
        {
          "datasource": { "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p95"
        },
        {
          "datasource": { "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP Error Rate (4xx + 5xx)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "datasource": { "uid": "prometheus" },
          "expr": "rate(http_requests_total{status_code=~\"4..|5..\"}[5m])",
          "legendFormat": "{{status_code}} {{endpoint}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Leads Ingested / min",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "datasource": { "uid": "prometheus" },
          "expr": "rate(leads_ingested_total[1m]) * 60",
          "legendFormat": "Tenant {{cuenta_id}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Automation Executions",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 16 },
      "targets": [
        {
          "datasource": { "uid": "prometheus" },
          "expr": "increase(automation_executions_total[1h])",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Webhook Dispatch Success Rate",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 16 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "thresholds": {
          "steps": [
            { "color": "red", "value": 0 },
            { "color": "yellow", "value": 90 },
            { "color": "green", "value": 99 }
          ]
        }
      },
      "targets": [
        {
          "datasource": { "uid": "prometheus" },
          "expr": "100 * rate(webhook_dispatches_total{status=\"success\"}[5m]) / rate(webhook_dispatches_total[5m])",
          "legendFormat": "Success %"
        }
      ]
    },
    {
      "id": 7,
      "title": "Request Size Distribution",
      "type": "timeseries",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 16 },
      "targets": [
        {
          "datasource": { "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, rate(http_request_size_bytes_bucket[5m]))",
          "legendFormat": "p95 request size"
        }
      ]
    },
    {
      "id": 8,
      "title": "Total Requests (1h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 16 },
      "targets": [
        {
          "datasource": { "uid": "prometheus" },
          "expr": "increase(http_requests_total[1h])",
          "legendFormat": "Requests"
        }
      ]
    }
  ]
}
